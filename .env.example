# ---------- AI ----------
# claude | azureopenai | ollama | none
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Per-item summaries/tags/rule scoring, and the daily digest. Both default to Claude Opus 5.5.
# For much lower per-item cost at high volume, set CLAUDE_MODEL=claude-haiku-5-5.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_DIGEST_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_DIGEST_EFFORT=medium
# Server-side refusal fallbacks (auto-disabled for Haiku models)
CLAUDE_FALLBACKS=true

# Azure OpenAI (AI_PROVIDER=azureopenai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DIGEST_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b

# Interactive research agent ("Ask the agent")
CLAUDE_CHAT_MODEL=claude-opus-5-5
CLAUDE_CHAT_EFFORT=medium
AZURE_OPENAI_CHAT_DEPLOYMENT=
AGENT_MAX_STEPS=12
# Optional threat-intel lookups (tools appear only when set)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=

# ---------- Sharing & integrations ----------
# TAXII 2.1 feed (/taxii2/) and MCP server (/mcp). Locally with AUTH_MODE=none and
# no token they're open; set tokens to require auth.
TAXII_TOKEN=
MCP_TOKEN=
# Optional MISP push
MISP_URL=
MISP_KEY=
MISP_VERIFY_TLS=true

AI_CONCURRENCY=4
AI_MAX_CHARS=24000

# ---------- Slack ----------
SLACK_WEBHOOK_URL=
SLACK_ENABLED=true

# ---------- Storage ----------
# azure (Table + Blob; Azurite locally) | memory (ephemeral)
STORAGE_MODE=azure
# Either a connection string (Azurite/local) ...
AZURE_STORAGE_CONNECTION_STRING=
# ... or an account name, authenticated with managed identity / az login
AZURE_STORAGE_ACCOUNT=

# ---------- Schedule ----------
SCHEDULER_ENABLED=true
RUN_ON_START=false
FETCH_CRON="0 * * * *"
DIGEST_CRON="0 8 * * *"
TZ=America/Chicago

# ---------- Pipeline ----------
RETENTION_DAYS=90
BACKFILL_DAYS=3
FETCH_FULL_TEXT=true
FETCH_CONCURRENCY=8
MAX_ITEMS_PER_FEED_PER_RUN=25
DEFAULT_RULE_THRESHOLD=70

# ---------- Server ----------
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
AUTH_MODE=none
LOG_LEVEL=info
