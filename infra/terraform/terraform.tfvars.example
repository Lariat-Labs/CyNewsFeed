subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus2"
name            = "cynews"

ai_provider         = "claude"
anthropic_api_key   = "sk-ant-..."
claude_model        = "claude-haiku-5-5" # per-story summaries (on demand by default)
claude_digest_model = "claude-opus-5-5"

claude_chat_model   = "claude-opus-5-5" # research agent

slack_webhook_url = "https://hooks.slack.com/services/..."

# Optional threat-intel lookups for the agent
virustotal_api_key = ""
abuseipdb_api_key  = ""
nvd_api_key        = ""

fetch_cron_utc  = "0 * * * *"
digest_cron_utc = "0 14 * * *" # 08:00 US Central
timezone        = "America/Chicago"

enable_auth = true
